# Copy this file to .env and fill in values if you want them (this app
# doesn't auto-load .env files - see the setup guide for how to set these
# on your hosting platform instead).

# Port the server listens on. Most hosting platforms set this automatically.
PORT=3000

# Where data/db.json lives. Leave unset for local use. On a hosting platform
# with a persistent volume, point this at the volume's mount path so your
# data survives redeploys.
DATA_DIR=

# Basic Auth login, so the app isn't wide open if you deploy it publicly.
# Leave both blank to disable auth (fine for local-only use).
APP_USERNAME=admin
APP_PASSWORD=
